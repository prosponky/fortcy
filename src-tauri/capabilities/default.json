{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:create-app-specific-dirs",
    "fs:scope-appdata-recursive"
  ]
}
